{
  "get": {
    "tags": ["Arts"],
    "summary": "List of approved arts (paginated)",
    "operationId": "getArts",
    "parameters": [
      {
        "$ref": "../../components/parameters.json#/components/parameters/PageQuery"
      }
    ],
    "responses": {
      "200": {
        "description": "Page of approved arts",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../components/schemas.json#/components/schemas/ArtsListResponse"
            }
          }
        }
      },
      "400": {
        "$ref": "../../components/responses.json#/components/responses/BadRequest"
      },
      "404": {
        "$ref": "../../components/responses.json#/components/responses/NotFound"
      },
      "500": {
        "$ref": "../../components/responses.json#/components/responses/InternalServerError"
      }
    }
  },
  "post": {
    "tags": ["Arts"],
    "summary": "Upload and register art",
    "operationId": "postArt",
    "requestBody": {
      "required": true,
      "content": {
        "multipart/form-data": {
          "schema": {
            "type": "object",
            "properties": {
              "image": {
                "type": "string",
                "format": "binary",
                "description": "Image ≤ 10MB; will be resized to 800px (JPEG 80%)."
              },
              "creator": { "type": "string" },
              "xProfile": { "type": "string" },
              "description": { "type": "string" }
            },
            "required": ["image", "creator", "xProfile", "description"]
          }
        }
      }
    },
    "responses": {
      "200": {
        "$ref": "../../components/responses.json#/components/responses/Empty200"
      },
      "400": {
        "$ref": "../../components/responses.json#/components/responses/BadRequest"
      },
      "500": {
        "$ref": "../../components/responses.json#/components/responses/InternalServerError"
      }
    }
  }
}
