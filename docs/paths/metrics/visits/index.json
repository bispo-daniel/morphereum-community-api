{
  "post": {
    "tags": ["Metrics"],
    "summary": "Register visit",
    "operationId": "registerVisit",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "../../../components/schemas.json#/components/schemas/RegisterVisitBody"
          }
        }
      }
    },
    "responses": {
      "200": {
        "$ref": "../../../components/responses.json#/components/responses/Empty200"
      },
      "400": {
        "$ref": "../../../components/responses.json#/components/responses/BadRequest"
      },
      "500": {
        "$ref": "../../../components/responses.json#/components/responses/InternalServerError"
      }
    }
  },
  "get": {
    "tags": ["Metrics"],
    "summary": "Get visits metrics (7 days, until yesterday)",
    "operationId": "getVisitsMetrics",
    "responses": {
      "200": {
        "description": "Time series of visits",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../../../components/schemas.json#/components/schemas/MetricsTimeSeries"
            }
          }
        }
      },
      "404": {
        "$ref": "../../../components/responses.json#/components/responses/NotFound"
      },
      "500": {
        "$ref": "../../../components/responses.json#/components/responses/InternalServerError"
      }
    }
  }
}
